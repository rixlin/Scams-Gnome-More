# Copy to .env and fill in. Values starting with PLACEHOLDER are treated as unset.

# Public HTTPS hostname of the Cloudflare tunnel (Twilio webhooks + WebSockets use this)
PUBLIC_BASE_URL=https://PLACEHOLDER-your-tunnel-hostname
# Shared secret the frontend sends as "Authorization: Bearer ..." and ?token= on WebSockets
API_TOKEN=PLACEHOLDER_API_TOKEN

TWILIO_ACCOUNT_SID=PLACEHOLDER_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=PLACEHOLDER_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=PLACEHOLDER_TWILIO_PHONE_NUMBER
# Set false only for local testing without Twilio
TWILIO_VALIDATE_SIGNATURE=true

GEMINI_API_KEY=PLACEHOLDER_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-preview
# TEXT for half-cascade Live models; AUDIO for native-audio Live models (we voice the transcript)
GEMINI_LIVE_MODALITY=TEXT

ELEVENLABS_API_KEY=PLACEHOLDER_ELEVENLABS_API_KEY
ELEVENLABS_VOICE_ID=PLACEHOLDER_ELEVENLABS_VOICE_ID
ELEVENLABS_MODEL=eleven_flash_v2_5

# Tiger Data service connection string
DATABASE_URL=PLACEHOLDER_DATABASE_URL
